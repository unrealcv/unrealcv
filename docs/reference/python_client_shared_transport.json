      "legacy_command": "vget /camera/{camera_id}/{viewmode} {mode}",
      "shared_command": "vget /camera/{camera_id}/{viewmode}_shared",
      "supported_viewmodes": ["lit", "normal", "object_mask", "seg"],
      "supported_modes": ["bmp", "png"],
      "fallback": "legacy TCP command",
      "return_contract": "decoded numpy image with the same shape semantics as the legacy TCP path"
    },
    {
      "python_function": "UnrealCv_API.get_depth",
